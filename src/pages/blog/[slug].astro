---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const siteURL = 'https://washingtonbookkeeper.com';
const bookingURL = 'https://b2bservicesgroup.zohobookings.com/#/b2bservicesgroup';
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: `${siteURL}/blog/${post.slug}`,
  author: { '@type': 'Organization', name: post.data.author, url: 'https://b2bsolutions.biz' },
  publisher: {
    '@type': 'Organization',
    name: 'WashingtonBookkeeper.com — B2B Solutions',
    logo: { '@type': 'ImageObject', url: `${siteURL}/logo/b2b-logo-768w.png` },
  },
};
---

<Layout title={post.data.title} description={post.data.description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Header />

  <main>
    <article>
      <header class="bg-sky">
        <div class="max-w-3xl mx-auto px-6 pt-16 pb-12 md:pt-20 flex flex-col gap-5">
          <a href="/blog" class="self-start text-accent font-bold no-underline hover:text-navy">&larr; All articles</a>
          <div class="flex items-center gap-3 text-sm">
            <span class="font-bold text-accent uppercase tracking-wide">{post.data.category}</span>
            <span class="text-muted">·</span>
            <time datetime={post.data.pubDate.toISOString()} class="text-muted">{fmt(post.data.pubDate)}</time>
          </div>
          <h1 class="font-heading font-extrabold text-[36px] md:text-[50px] leading-[1.08] text-navy tracking-tight">{post.data.title}</h1>
          <p class="text-xl text-muted">{post.data.description}</p>
        </div>
      </header>

      <div class="bg-white">
        <div class="max-w-3xl mx-auto px-6 py-14 md:py-16">
          <div
            class="prose prose-lg max-w-none
                   prose-headings:font-heading prose-headings:text-navy prose-headings:tracking-tight
                   prose-h2:text-[32px] prose-h2:mt-14 prose-h3:text-[22px]
                   prose-p:text-ink prose-li:text-ink prose-strong:text-navy
                   prose-a:text-accent prose-a:font-semibold hover:prose-a:text-navy
                   prose-li:marker:text-accent"
          >
            <Content />
          </div>
        </div>
      </div>
    </article>

    <section class="bg-sky">
      <div class="max-w-3xl mx-auto px-6 py-16 md:py-20">
        <div class="bg-navy text-white rounded-[20px] p-8 md:p-10 flex flex-col gap-4">
          <h2 class="font-heading font-extrabold text-2xl md:text-3xl">Behind on your books?</h2>
          <p class="text-lg text-[#D6E4F5]">We'll review where things stand and quote a cleanup project, then keep you current with a flat monthly plan.</p>
          <div class="flex flex-wrap gap-3.5">
            <a href={bookingURL} class="bg-white text-navy no-underline font-bold px-7 py-3.5 rounded-full hover:bg-sky2 transition-colors">Book a free consultation</a>
            <a href="/pricing" class="bg-transparent text-white no-underline font-bold px-7 py-3.5 rounded-full border-2 border-white hover:bg-white/10 transition-colors">See monthly plans</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
