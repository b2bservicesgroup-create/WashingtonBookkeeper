---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { cityPages, type CityPage } from '../../data/serviceAreas';

export function getStaticPaths() {
  return cityPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: CityPage };
const { city, county, inPerson, slug } = page;

const bookingURL = 'https://b2bservicesgroup.zohobookings.com/#/b2bservicesgroup';
const b2bCityURL = `https://b2bsolutions.biz/service-areas/${slug}`;
const others = cityPages.filter((p) => p.slug !== slug);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: 'WashingtonBookkeeper.com — B2B Solutions',
  url: `https://washingtonbookkeeper.com/service-areas/${slug}`,
  telephone: '360-529-2672',
  email: 'info@b2bsolutions.biz',
  address: { '@type': 'PostalAddress', addressLocality: 'Rochester', addressRegion: 'WA', addressCountry: 'US' },
  areaServed: {
    '@type': 'City',
    name: city,
    containedInPlace: { '@type': 'AdministrativeArea', name: `${county}, Washington` },
  },
  description: page.metaDescription,
  priceRange: '$$',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={page.title} description={page.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />

  <main>
    <!-- Intro -->
    <section class="bg-sky">
      <div class="max-w-6xl mx-auto px-6 pt-16 pb-16 md:pt-24 md:pb-20">
        <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
          <a href="/" class="text-muted no-underline hover:text-accent">Home</a>
          <span class="mx-2">›</span>
          <a href="/service-areas" class="text-muted no-underline hover:text-accent">Service areas</a>
          <span class="mx-2">›</span>
          <span class="text-navy font-semibold">{city}, WA</span>
        </nav>
        <div class="max-w-3xl flex flex-col gap-5">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">
            {page.eyebrow} · {county} · {inPerson ? 'In person & remote' : 'Remote service'}
          </div>
          <h1 class="font-heading font-extrabold text-[38px] md:text-[52px] leading-[1.08] text-navy tracking-tight">{page.h1}</h1>
          {page.intro.map((p) => <p class="text-muted text-xl">{p}</p>)}
          <div class="flex flex-wrap gap-3.5 mt-2">
            <a href={bookingURL} class="bg-accent text-white no-underline font-bold px-7 py-4 rounded-full hover:bg-navy transition-colors">Book a free consultation</a>
            <a href="tel:3605292672" class="bg-white text-navy no-underline font-bold px-7 py-4 rounded-full border-2 border-navy hover:bg-sky2 transition-colors">Call 360-529-2672</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Local rules -->
    <section class="bg-white">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-10">
        <div class="max-w-3xl flex flex-col gap-4">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">Local rules</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[40px] leading-tight text-navy">What {city} books have to account for</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {page.localRules.map((r) => (
            <div class="bg-sky2 rounded-2xl p-7 flex flex-col gap-3">
              <h3 class="font-heading text-xl text-navy">{r.title}</h3>
              <p class="text-muted text-base">{r.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What we set up -->
    <section class="bg-sky">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 grid gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div class="flex flex-col gap-4">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">What we set up</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[40px] leading-tight text-navy">Books built for {city}</h2>
          <p class="text-muted">
            Every plan includes monthly reconciliation, financial statements and a plain-language summary.
            Plans start at $250 a month — <a href="/pricing" class="text-accent font-semibold">compare plans</a>.
          </p>
        </div>
        <ul class="flex flex-col gap-3.5 list-none p-0 m-0">
          {page.books.map((b) => (
            <li class="bg-white rounded-2xl px-7 py-6 flex gap-4 items-start">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0F7A55" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" class="shrink-0 mt-1"><path d="M5 12l5 5 9-10"></path></svg>
              <div>
                <h3 class="font-heading text-lg text-navy mb-1">{b.title}</h3>
                <p class="text-muted text-base">{b.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white">
      <div class="max-w-3xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-8">
        <h2 class="font-heading font-extrabold text-3xl md:text-[40px] leading-tight text-navy text-center">{city} bookkeeping questions</h2>
        <div class="flex flex-col gap-3.5">
          {page.faqs.map((f) => (
            <div class="bg-sky2 rounded-2xl px-7 py-6">
              <h3 class="font-heading text-xl text-navy mb-2">{f.q}</h3>
              <p class="text-muted">{f.a}</p>
            </div>
          ))}
        </div>
        <p class="text-muted text-base text-center">
          Need payroll or HR in {city}? See <a href={b2bCityURL} class="text-accent font-semibold">payroll and HR for {city} employers</a> at B2B Solutions.
        </p>
        <div class="text-sm text-muted border-t border-[#E3ECF7] pt-6">
          <p class="mb-2">Local rules checked October 2026. Rules change — confirm with the city or the Department of Revenue before acting. We don't prepare tax returns.</p>
          <ul class="list-none p-0 m-0 flex flex-col gap-1">
            {page.sources.map((s) => (
              <li><a href={s.url} class="text-muted underline hover:text-accent" rel="noopener">{s.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Other cities -->
    <section class="bg-sky2">
      <div class="max-w-6xl mx-auto px-6 py-14 flex flex-col gap-5">
        <h2 class="font-heading font-extrabold text-2xl text-navy">More Washington service areas</h2>
        <div class="flex flex-wrap gap-2.5">
          {others.map((o) => (
            <a href={`/service-areas/${o.slug}`} class="bg-white text-navy no-underline font-semibold px-4 py-2 rounded-full border border-[#E3ECF7] hover:border-accent hover:text-accent">Bookkeeping in {o.city}</a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-accent text-white">
      <div class="max-w-4xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-5 items-center text-center">
        <h2 class="font-heading font-extrabold text-3xl md:text-[46px] leading-tight">Ready for books you don't have to worry about?</h2>
        <p class="text-xl text-[#EAF3FF] max-w-xl">
          {inPerson ? `Free consultation in ${city}, at our Rochester office, or by video.` : 'Free consultation by phone or video.'}
        </p>
        <div class="flex flex-wrap gap-3.5 justify-center">
          <a href={bookingURL} class="bg-white text-navy no-underline font-bold px-8 py-4 rounded-full text-lg hover:bg-sky2 transition-colors">Book a free consultation</a>
          <a href="tel:3605292672" class="bg-transparent text-white no-underline font-bold px-8 py-4 rounded-full text-lg border-2 border-white hover:bg-white/10 transition-colors">Call 360-529-2672</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
