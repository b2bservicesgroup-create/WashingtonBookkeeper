---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { cityPages } from '../../data/serviceAreas';

const bookingURL = 'https://b2bservicesgroup.zohobookings.com/#/b2bservicesgroup';
---

<Layout
  title="Bookkeeping Service Areas in Washington"
  description="Small business bookkeeping in Olympia, Tacoma, Centralia, Chehalis and Rochester, WA — and remotely anywhere in Washington — from WashingtonBookkeeper.com in Rochester."
>
  <Header />

  <main>
    <section class="bg-sky">
      <div class="max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-24">
        <div class="max-w-3xl flex flex-col gap-4">
        <div class="text-accent font-bold text-sm tracking-widest uppercase">Service areas</div>
        <h1 class="font-heading font-extrabold text-[40px] md:text-[56px] leading-[1.05] text-navy tracking-tight">
          Bookkeeping across <span class="text-accent">Washington.</span>
        </h1>
        <p class="text-muted text-xl">
          We meet clients in person across Thurston and Lewis counties and work remotely everywhere else in the state. Each city has its own rules — here's what we handle in yours.
        </p>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="max-w-6xl mx-auto px-6 py-20 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {cityPages.map((p) => (
          <a href={`/service-areas/${p.slug}`} class="bg-sky2 rounded-2xl p-7 no-underline flex flex-col gap-2 border border-transparent hover:border-accent transition-colors">
            <div class="text-accent font-bold text-xs tracking-widest uppercase">{p.county} · {p.inPerson ? 'In person & remote' : 'Remote'}</div>
            <h2 class="font-heading text-2xl text-navy">Bookkeeping in {p.city}</h2>
            <p class="text-muted text-base">{p.localRules[0].title}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-accent text-white">
      <div class="max-w-4xl mx-auto px-6 py-20 flex flex-col gap-5 items-center text-center">
        <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight">Don't see your city?</h2>
        <p class="text-xl text-[#EAF3FF] max-w-xl">We keep books for small businesses anywhere in Washington remotely.</p>
        <a href={bookingURL} class="bg-white text-navy no-underline font-bold px-8 py-4 rounded-full text-lg hover:bg-sky2 transition-colors">Book a free consultation</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
